# pyenv
#   For a library or app, you might want to share your .python-version.
#   If so, comment this line.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building a library, you should skip it.
#Pipfile.lock

# poetry
#   Poetry uses poetry.lock to ensure reproducible builds.
#   It's recommended to include it in version control for applications, but skip for libraries.
#poetry.lock

# pdm
#   PDM stores its configuration in .pdm-python
.pdm-python
#   PDM local providers
.pdm-build/

# Celery stuff
celerybeat-schedule
celerybeat.pid

